<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Background="#111417" Margin="0" TextOptions.TextRenderingMode="Grayscale">
  <Grid.Resources>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EAED"/><Setter Property="FontFamily" Value="Microsoft YaHei UI"/></Style>
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#C9CED3"/><Setter Property="Background" Value="#1A1E23"/><Setter Property="BorderBrush" Value="#2C3238"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="15,8"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262B30"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#7A838B"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#14171A"/><Setter Property="Background" Value="#D7DBDF"/><Setter Property="BorderBrush" Value="#D7DBDF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="26,12"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E8EAED"/><Setter Property="BorderBrush" Value="#E8EAED"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#3A4046"/><Setter Property="BorderBrush" Value="#3A4046"/><Setter Property="Foreground" Value="#7A838B"/><Setter Property="Cursor" Value="Arrow"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI"/><Setter Property="Foreground" Value="#6B747C"/><Setter Property="Background" Value="#1A1E23"/><Setter Property="BorderBrush" Value="#2C3238"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="#C7CDD3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border x:Name="Box" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#C7CDD3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="#9AA3AB"/><Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="3,3"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#262B30"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#3A4046"/><Setter Property="Foreground" Value="#E8EAED"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="#C9CED3"/><Setter Property="Background" Value="#1A1E23"/><Setter Property="Padding" Value="8,7"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter>
      <Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#3A4046"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#2C3238"/><Setter Property="Foreground" Value="#E8EAED"/></Trigger></Style.Triggers>
    </Style>
    <Style x:Key="FormatComboStyle" TargetType="ComboBox">
      <Setter Property="Foreground" Value="#C9CED3"/><Setter Property="Background" Value="#1A1E23"/><Setter Property="BorderBrush" Value="#2C3238"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><Border x:Name="Shell" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"><Grid><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" VerticalAlignment="Center" Margin="9,0,23,0"/><Path Data="M 0 0 L 5 5 L 10 0" Stroke="#9AA3AB" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Grid></Border><ToggleButton Focusable="False" Opacity="0" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/><Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Shell}" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" StaysOpen="False"><Border Background="#1A1E23" BorderBrush="#2C3238" BorderThickness="1" MinWidth="190"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Shell" Property="BorderBrush" Value="#C7CDD3"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SilverProgressStyle" TargetType="ProgressBar"><Setter Property="Background" Value="#262B30"/><Setter Property="Foreground" Value="#C7CDD3"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Grid><Border x:Name="PART_Track" Background="{TemplateBinding Background}"/><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left"/></Grid></ControlTemplate></Setter.Value></Setter></Style>
  </Grid.Resources>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Grid.Row="0" Background="#1A1E23" Padding="28,23" BorderBrush="#2C3238" BorderThickness="0,0,0,1">
    <DockPanel>
      <Border Background="#1A1E23" Width="52" Height="52" CornerRadius="14" DockPanel.Dock="Left" Margin="0,0,17,0"><Image x:Name="HeaderIcon" Width="52" Height="52" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform Angle="0"/></Image.RenderTransform></Image></Border>
      <StackPanel VerticalAlignment="Center"><TextBlock Text="像素转换" FontSize="23" FontWeight="Bold"/><TextBlock Text="图片格式转换 · RAW 原图优先" Foreground="#9AA3AB" FontSize="12" Margin="0,3,0,0"/></StackPanel>
    </DockPanel>
  </Border>
  <Grid Grid.Row="1" Margin="28,23,28,18">
    <Grid.RowDefinitions><RowDefinition Height="150"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Border x:Name="DropZone" Grid.Row="0" AllowDrop="True" BorderThickness="0" CornerRadius="16" Background="#161B1F" Cursor="Hand">
      <Grid><Rectangle x:Name="DropOutline" Stroke="#3A4249" StrokeThickness="1" StrokeDashArray="5 4" RadiusX="16" RadiusY="16" Margin="0.5" IsHitTestVisible="False"/>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="＋" Foreground="#C7CDD3" FontSize="29" HorizontalAlignment="Center"/>
          <TextBlock Text="把 RAW 或图片拖到这里" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
          <TextBlock Text="支持多文件和文件夹 · 在本机完成转换" Foreground="#9AA3AB" FontSize="12" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <DockPanel Grid.Row="1" Margin="0,15,0,12">
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Left"><Button x:Name="AddFilesButton" Style="{StaticResource SecondaryButtonStyle}" Content="添加文件" Margin="0,0,8,0"/><Button x:Name="AddFolderButton" Style="{StaticResource SecondaryButtonStyle}" Content="添加文件夹"/><Button x:Name="ClearButton" Style="{StaticResource SecondaryButtonStyle}" Content="清空" Margin="8,0,0,0"/></StackPanel>
      <TextBlock x:Name="CountText" Text="0 个文件" Foreground="#9AA3AB" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </DockPanel>
    <Border Grid.Row="2" CornerRadius="10" BorderBrush="#2C3238" BorderThickness="1" Background="#1A1E23">
      <ListBox x:Name="FileList" Background="Transparent" Foreground="#6B747C" BorderThickness="0" FontFamily="Consolas" FontSize="12" Padding="7" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
    </Border>
    <Grid Grid.Row="3" Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="190"/><ColumnDefinition Width="18"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="输出格式" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <ComboBox x:Name="FormatBox" Grid.Column="1" Style="{StaticResource FormatComboStyle}" Padding="8,5" Height="38" FontFamily="Microsoft YaHei UI"><ComboBoxItem Content="JPG · 最高画质" Tag="jpg" IsSelected="True"/><ComboBoxItem Content="PNG · 16 位" Tag="png"/><ComboBoxItem Content="TIFF · 16 位" Tag="tif"/></ComboBox>
      <TextBlock Grid.Column="3" Text="保存到" VerticalAlignment="Center" Margin="0,0,10,0"/>
      <TextBox x:Name="OutputBox" Grid.Column="4" Height="38" VerticalContentAlignment="Center"/>
      <Button x:Name="BrowseOutputButton" Grid.Column="5" Style="{StaticResource SecondaryButtonStyle}" Content="浏览" Margin="8,0,0,0"/>
    </Grid>
    <TextBlock Grid.Row="4" Text="JPG 默认：原始尺寸 · 质量 100 · 4:4:4 色度采样；原图保留。" Foreground="#6B747C" FontSize="11" Margin="0,12,0,0"/>
  </Grid>
  <Border Grid.Row="2" Background="#1A1E23" BorderBrush="#2C3238" BorderThickness="0,1,0,0" Padding="28,17">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" VerticalAlignment="Center"><TextBlock x:Name="StatusText" Text="添加图片即可开始" Foreground="#9AA3AB" TextTrimming="CharacterEllipsis"/><ProgressBar x:Name="Progress" Style="{StaticResource SilverProgressStyle}" Height="5" Margin="0,9,20,0"/></StackPanel>
      <Button x:Name="ConvertButton" Grid.Column="1" Style="{StaticResource PrimaryButtonStyle}" Content="开始转换" FontSize="15" FontWeight="Bold" IsEnabled="False"/>
    </Grid>
  </Border>
</Grid>
